    "version": "1.0.0",
	"license": "Proprietary/All rights reserved",
    "authors": [
        {
            "name": "Jakub Senko",
            "email": "jakubsenko@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.1",
        "composer/installers": "~1.0",
        "minishlink/web-push": "^4.0"
    },
    "extra": {
